# Independent container configuration. The existing .env is not copied into the image.
APP_NAME=Custom Service Agent
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Map SHA-256 digests of high-entropy bearer tokens to trusted identities. See RUNTIME.md.
AUTH_TOKEN_DIGESTS={}

# Replace with the confirmed remote Tailscale address and database credentials.
# .invalid is a deliberate placeholder; this configuration does not connect to a real DB.
DATABASE_URL=mysql+asyncmy://replace_me:replace_me@remote-host.invalid:3306/custom_service_agent
MILVUS_HOST=remote-host.invalid
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_COLLECTION=knowledge_chunks
MILVUS_VECTOR_DIM=1536
ELASTICSEARCH_URL=http://remote-host.invalid:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=knowledge_chunks

# Supply API credentials later. No model request is made by /health or /docs.
LLM_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
LLM_API_KEY=
DASHSCOPE_API_KEY=
MINERU_API_KEY=

# Workspace-scoped OpenAI-compatible embeddings. Endpoint is the complete URL.
EMBEDDING_WORKSPACE_ID=your_workspace_id
EMBEDDING_ENDPOINT=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20

# Rerank is a separate native DashScope endpoint and model.
# With the same origin, an empty RERANK_API_KEY reuses EMBEDDING_API_KEY.
RERANK_ENDPOINT=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=

# Bootstrap only: avoid checkpoint setup before the remote DB is confirmed.
LANGGRAPH_CHECKPOINT_ENABLED=false
RAG_RERANK_ENABLED=false
